# Vercel ignore file
# Files and directories to exclude from Vercel deployments

# Dependencies
node_modules/

# Build outputs
.next/
out/
dist/
build/

# Environment files
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Backups
backups/

# Scripts (not needed in production)
scripts/

# Documentation (optional - remove if you want docs deployed)
*.md
!README.md
